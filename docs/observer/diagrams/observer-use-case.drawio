        <mxCell id="scope" value="Đặt lịch bị từ chối (ca kín, đổi giá, mất quyền hưởng) không phát sự kiện, nên không có email hay thao tác cache. Thêm phản ứng mới = thêm một use case observer, không đổi &quot;Đặt lịch khám&quot;." style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=5;" vertex="1" parent="1">
