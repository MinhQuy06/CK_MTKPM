        <mxCell id="n-booking" value="Báo giá và đặt lịch INSURANCE/VIP chỉ chấp nhận yêu cầu APPROVED có khoảng [approved_from, approved_until] bao phủ ngày khám." style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=note;size=18;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=10;" vertex="1" parent="1">
