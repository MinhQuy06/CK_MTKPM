        </mxCell>
        <mxCell id="n-lock" value="Mỗi quyết định của Admin khóa bản ghi và kiểm tra trạng thái nguồn (PENDING cho duyệt/từ chối, APPROVED cho thu hồi). Sai trạng thái → 409 &quot;vui lòng tải lại&quot;. Cột version chống ghi đè đồng thời." style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=note;size=18;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=10;" vertex="1" parent="1">
