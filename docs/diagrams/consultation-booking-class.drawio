        </mxCell>
        <mxCell id="controller" value="«REST Controller»&#10;BookingController" style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;swimlane;startSize=52;horizontal=1;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="controller-body" value="+ createBooking(actor, request): legacy POST /appointments&#10;+ confirmBooking(actor, request): POST /appointments/confirm&#10;&#10;JWT + PATIENT; strict route requires quote fields.&#10;Authenticated patient ID comes from principal." style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=10;" vertex="1" parent="controller">
          <mxGeometry x="0" y="52" width="540" height="178" as="geometry" />
        </mxCell>
        <mxCell id="service" value="«Client / Transaction boundary»&#10;BookingServiceImpl" style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;swimlane;startSize=52;horizontal=1;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="540" height="365" as="geometry" />
        </mxCell>
        <mxCell id="service-body" value="- schedules: ScheduleRepository&#10;- appointments: AppointmentRepository&#10;- pricing: PricingContext&#10;&#10;+ createBooking(patientId, request): AppointmentDto&#10;- confirmedPrice(request, doctor): PricingAmounts&#10;&#10;Lock slot; validate; calculate and compare quote;&#10;save snapshot and unavailable slot; notify after commit.&#10;This stage accepts STANDARD booking only." style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=10;" vertex="1" parent="service">
          <mxGeometry x="0" y="52" width="540" height="313" as="geometry" />
