          <mxGeometry x="760" y="470" width="470" height="245" as="geometry" />
        </mxCell>
        <mxCell id="context-body" value="- strategies: Map&lt;String, ConsultationPricingStrategy&gt;&#10;+ calculate(key, fee): PricingAmounts&#10;+ supports(key): boolean&#10;&#10;Registered algorithms; common monetary validation&#10;and HALF_UP VND normalization." style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=10;" vertex="1" parent="context">
