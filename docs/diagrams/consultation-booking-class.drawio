        </mxCell>
        <mxCell id="interface-body" value="+ key(): String&#10;+ name(): String&#10;+ discountRate(): BigDecimal&#10;+ calculate(basePrice: BigDecimal): BigDecimal&#10;+ simulated(): boolean" style="fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;shadow=0;shape=text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=10;" vertex="1" parent="interface">
