# =====================================================================
# .env.example — cấu hình cho docker-compose.prod.yml
#   cp .env.example .env   (file .env đã nằm trong .gitignore, KHÔNG commit)
# =====================================================================

# ── Hạ tầng (đặt mật khẩu riêng, mạnh) ──────────────────────────────
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USERNAME=clinic
RABBITMQ_PASSWORD=

# ── Ứng dụng ────────────────────────────────────────────────────────
APP_PORT=18081
# Tạo bằng: openssl rand -hex 64
JWT_SECRET=
# Origin được phép gọi API (mặc định đúng với APP_PORT)
CORS_ALLOWED_ORIGINS=http://localhost:18081

# ── Admin đầu tiên (chỉ tạo khi chưa có Admin nào; mật khẩu >= 8 ký tự) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email thật (Gmail: bật xác minh 2 bước, tạo App Password) ───────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Người gửi; để trống thì dùng MAIL_USERNAME
MAIL_FROM=

# ── SMS thật qua eSMS (mặc định TẮT vì mất phí theo tin) ────────────
SMS_ENABLED=false
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=8
# true: eSMS nhận tin nhưng không gửi và không trừ tiền (dùng để thử)
ESMS_SANDBOX=false
