# =====================================================================
# .env.example — cấu hình cho docker-compose.prod.yml (hướng dẫn: docs/production.md)
#   Cách nhanh: ./scripts/demo-up.sh tự tạo .env với bí mật ngẫu nhiên.
#   Cách tay:   cp .env.example .env rồi điền. File .env nằm trong .gitignore, KHÔNG commit.
# =====================================================================

# ── Chế độ chạy ─────────────────────────────────────────────────────
# prod,demo : có dữ liệu mẫu, email vào Mailpit (http://localhost:8025), SMS tắt. Không gửi gì ra ngoài.
# prod      : chế độ thật, không dữ liệu mẫu; cần MAIL_* thật bên dưới (và ESMS_* nếu bật SMS).
APP_PROFILES=prod,demo

# ── Hạ tầng (bắt buộc; đặt mật khẩu riêng, mạnh) ────────────────────
# MySQL tạm thời không cần user/mật khẩu (root, rỗng; không mở cổng ra ngoài).
REDIS_PASSWORD=
RABBITMQ_USERNAME=clinic
RABBITMQ_PASSWORD=

# ── Ứng dụng ────────────────────────────────────────────────────────
APP_PORT=18081
MAILPIT_UI_PORT=8025
# Bắt buộc. Tạo bằng: openssl rand -hex 64
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:18081

# ── Admin đầu tiên (bắt buộc; chỉ được tạo khi chưa có Admin nào) ───
# Ở chế độ demo đã có Admin mẫu nên tài khoản này không được tạo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email thật (chỉ cho APP_PROFILES=prod) ──────────────────────────
# Để trống = gửi vào Mailpit. Gmail: bật xác minh 2 bước, tạo App Password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=phongkham.cua.ban@gmail.com
# MAIL_PASSWORD=app-password-16-ky-tu
# MAIL_FROM=

# ── SMS thật qua eSMS (chỉ cho APP_PROFILES=prod; mất phí theo tin) ─
SMS_ENABLED=false
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=8
# true: eSMS nhận tin nhưng không gửi và không trừ tiền (dùng để thử)
ESMS_SANDBOX=false
